{
    "openapi": "3.0.0",
    "info": {
        "title": "Blexchat API",
        "description": "REST API for Blexchat — social commerce DM and comment automation platform supporting Instagram, WhatsApp, TikTok, and Messenger.",
        "contact": {
            "email": "api@blexchat.com"
        },
        "license": {
            "name": "Proprietary"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "This server"
        }
    ],
    "paths": {
        "/api/v1/home": {
            "get": {
                "tags": [
                    "Home"
                ],
                "summary": "Get the complete public marketing homepage",
                "description": "Every homepage section in display order and the live-demo reply rules. No authentication.\n\n**Language**\n- Send `?lang=ar` for Arabic or `?lang=en` for English.\n- Without `lang`, the `Accept-Language` header is used (`ar`, `ar-SA`, `en-US`…).\n- A missing or unsupported language returns English.\n- The response states the language it was served in: `meta.locale` and the `Content-Language` header.\n- Any text not yet translated is served in English, field by field, and `meta.fallback` is then `true`.",
                "operationId": "9578f64b5c6ee0a342418701420a15fc",
                "parameters": [
                    {
                        "name": "lang",
                        "in": "query",
                        "description": "Language of the content. Takes precedence over Accept-Language. Defaults to en.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "en",
                            "enum": [
                                "en",
                                "ar"
                            ]
                        },
                        "example": "ar"
                    },
                    {
                        "name": "Accept-Language",
                        "in": "header",
                        "description": "Used only when `lang` is absent; the first two letters are read (ar-SA → ar).",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "ar"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Complete homepage content",
                        "headers": {
                            "Content-Language": {
                                "description": "Language of the returned content",
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MarketingHome"
                                        },
                                        "meta": {
                                            "properties": {
                                                "locale": {
                                                    "description": "Language the content was served in",
                                                    "type": "string",
                                                    "example": "ar",
                                                    "enum": [
                                                        "en",
                                                        "ar"
                                                    ]
                                                },
                                                "fallback": {
                                                    "description": "True when at least one text is not translated yet and is served in English",
                                                    "type": "boolean"
                                                },
                                                "available_locales": {
                                                    "description": "Every value `lang` accepts",
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "en",
                                                        "ar"
                                                    ]
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Homepage content has not been seeded"
                    }
                }
            }
        }
    },
