        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new business account",
                "operationId": "7ca6fc7989202054d29707fef91a2d4a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "business_name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Omar Al-Rashid"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "omar@store.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "S3cur3P@ss!",
                                        "minLength": 8
                                    },
                                    "business_name": {
                                        "type": "string",
                                        "example": "Omar's Store"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Account created"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login and receive access token",
                "operationId": "9d0bb5c770cbec19b0b9566606ef4adb",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
