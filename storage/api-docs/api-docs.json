{
    "openapi": "3.0.0",
    "info": {
        "title": "Blexchat API",
        "description": "REST API for Blexchat — social commerce DM and comment automation platform supporting Instagram, WhatsApp, TikTok, and Messenger.",
        "contact": {
            "email": "api@blexchat.com"
        },
        "license": {
            "name": "Proprietary"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://api.blexchat.com",
            "description": "Production"
        },
        {
            "url": "http://blexchat.test",
            "description": "Local development"
        }
    ],
    "paths": {
        "/api/v1/home": {
            "get": {
                "tags": [
                    "Home"
                ],
                "summary": "Get the complete public marketing homepage",
                "description": "Navigation, every homepage section in display order, the live-demo reply rules and the footer. No authentication. Language comes from ?lang= or Accept-Language. Any text not yet translated into that language is served in English, field by field, and meta.fallback is then true.",
                "operationId": "9578f64b5c6ee0a342418701420a15fc",
                "parameters": [
                    {
                        "name": "lang",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "en",
                                "ar"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Complete homepage content",
                        "headers": {
                            "Content-Language": {
                                "description": "Language of the returned content",
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/MarketingHome"
                                        },
                                        "meta": {
                                            "properties": {
                                                "locale": {
                                                    "description": "Language of the returned content",
                                                    "type": "string",
                                                    "example": "ar"
                                                },
                                                "fallback": {
                                                    "description": "True when at least one text is not translated yet and is served in English",
                                                    "type": "boolean"
                                                },
                                                "available_locales": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    },
                                                    "example": [
                                                        "en",
                                                        "ar"
                                                    ]
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Homepage content has not been seeded"
                    }
                }
            }
        }
    },
