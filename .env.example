APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Instagram API with Instagram Login (developers.facebook.com → your app → Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Frontend page Instagram sends the owner back to; must be listed in the app's OAuth redirect URIs
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_CONFIG_ID=
# meta (real Instagram) or fake (test sign-in page, demo posts; default on local). Production refuses fake unless INSTAGRAM_ALLOW_FAKE=true
INSTAGRAM_DRIVER=
INSTAGRAM_ALLOW_FAKE=false
# Any random string; enter the same value as the webhook "Verify token" in the app dashboard
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_GRAPH_VERSION=v21.0

# Meta webhook verification and channel OAuth. Set CHANNEL_OAUTH_DRIVER=provider only after
# configuring the real Meta/TikTok applications; local development uses fake OAuth by default.
# Messenger and WhatsApp share the Meta app; TikTok has its own application.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
CHANNEL_OAUTH_DRIVER=
CHANNEL_OAUTH_REDIRECT_URL=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# The React site (emailed links and Google return to its /verify/confirm). Local frontend: http://localhost:5173
FRONTEND_URL=https://blexchat-screens.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development servers only: return the sign-in link in the API response
AUTH_EXPOSE_LOGIN_LINKS=false
# Empty: Google returns to FRONTEND_URL/verify/confirm. To test without the frontend: APP_URL/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# Payment page for paid plans: fake (a test page this app serves, no keys; the default on local) or stripe.
# fake is refused when APP_ENV=production unless PAYMENT_ALLOW_FAKE=true (e.g. a development server on Laravel Cloud).
PAYMENT_DRIVER=fake
PAYMENT_ALLOW_FAKE=false

# Stripe Checkout, test mode: sk_test_… from dashboard.stripe.com/test/apikeys, and the whsec_… printed by
# `stripe listen --forward-to localhost/api/v1/webhooks/stripe` (or the Cloud webhook endpoint's signing secret)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
